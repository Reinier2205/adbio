{
  "type": "object",
  "properties": {
    "genre": {
      "type": "string",
      "description": "Primary genre(s) of the soundtrack"
    },
    "mood": {
      "type": "string",
      "description": "Overall mood of the track"
    },
    "emotion": {
      "type": "string",
      "description": "Core emotional tone"
    },
    "tempo_bpm": {
      "type": "number",
      "description": "Suggested tempo in BPM"
    },
    "rhythm": {
      "type": "string",
      "description": "Rhythmic feel or pattern"
    },
    "instruments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Key instruments to use"
    },
    "vocal_style": {
      "type": "string",
      "description": "Vocal style description, or 'instrumental' if no vocals"
    },
    "energy": {
      "type": "string",
      "description": "Energy level (e.g. low, medium, high)"
    },
    "song_structure": {
      "type": "string",
      "description": "Suggested Suno section structure (e.g. Intro, Verse, Chorus, Bridge, Outro)"
    },
    "production_style": {
      "type": "string",
      "description": "Production and mix style notes"
    },
    "suno_style_tags": {
      "type": "string",
      "description": "Compact, copy-ready Suno style tag string"
    }
  },
  "required": ["genre", "mood", "emotion", "tempo_bpm", "rhythm", "instruments", "vocal_style", "energy", "song_structure", "production_style", "suno_style_tags"]
}
