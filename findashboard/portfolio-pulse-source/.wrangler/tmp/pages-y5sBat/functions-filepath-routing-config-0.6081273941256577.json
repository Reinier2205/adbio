{
  "routes": [
    {
      "routePath": "/api/records/:date",
      "mountPath": "/api/records",
      "method": "DELETE",
      "module": [
        "api/records/[date].js:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/records",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/records.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/records",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/records.js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}